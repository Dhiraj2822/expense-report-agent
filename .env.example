# LLM
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Email
FINANCE_EMAIL=finance@yourcompany.com
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
SMTP_FROM=agent@expense-report.dev

# SMTP settings (used only when EMAIL_PROVIDER=smtp)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Optional date override for reproducible demos (YYYY-MM-DD)
REPORT_TODAY=2026-10-01

# Long-term memory
CHROMA_PERSIST_DIR=chroma_db
MEMORY_TOP_K=3
MEMORY_SIMILARITY_THRESHOLD=0.80
SHORT_TERM_WINDOW=5

# Missing-data feedback loop
MAX_MISSING_RETRIES=2
